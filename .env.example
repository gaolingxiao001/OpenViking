# Stable deployment id. PM2, updater, Web and the agent's self-upgrade command
# all derive from this one value: lark-daemon-<id> / lark-daemon upgrade <id>.
LARK_DAEMON_INSTANCE_ID=my-agent

# The exact lark-cli profile used by this instance.
LARK_DAEMON_PROFILE=
# Must equal LARK_DAEMON_PROFILE. This also pins every lark-cli shell fallback.
LARKSUITE_CLI_PROFILE=

# Human-facing identity substituted into the shared system prompt.
LARK_DAEMON_AGENT_NAME=

LARK_CLI_BIN=/opt/homebrew/bin/lark-cli
CODEX_BIN=/opt/homebrew/bin/codex
# Optional. Plain "claude" uses PATH; set the absolute path when the npm global
# bin directory is not on the daemon service's PATH.
CLAUDE_BIN=claude

# Keep the source-tree development default separate from the daemon itself.
# Empty uses ~/Documents/work/lark-agent-workspace; the installed PM2 release
# on this Mac sets ~/Documents/work in ~/.local/lib/lark-daemon/env instead.
LARK_DAEMON_WORKSPACE=

LARK_DAEMON_HOST=127.0.0.1
LARK_DAEMON_PORT=3738
LARK_DAEMON_LOG_LEVEL=info

# After this much outbound-delivery inactivity, authenticated idle= metadata
# lets the model opt into one temporary OnIt for genuinely long work. Merely
# receiving or ignoring a message never reacts and does not reset the window.
# Set 0 to disable the hint.
LARK_DAEMON_IDLE_REACTION_AFTER_MS=600000

# text/post only; raw events are enforced by the daemon.
LARK_DAEMON_ALLOWED_MESSAGE_TYPES=text,post

# All chats share one persistent Codex app-server thread (cross-chat context).
# minimal | low | medium | high | xhigh
LARK_DAEMON_CODEX_EFFORT=medium
# Optional model override; empty uses the codex default.
LARK_DAEMON_CODEX_MODEL=

# low | medium | high | xhigh | max
LARK_DAEMON_CLAUDE_EFFORT=medium
# fable | opus | sonnet | haiku; empty uses Claude's configured default.
LARK_DAEMON_CLAUDE_MODEL=

# Maximum observable journal prefix used for a hard runtime handoff.
LARK_DAEMON_COGNITION_MAX_CHARS=120000

# Cross-chat history lines injected into a fresh thread's first turn.
LARK_DAEMON_HISTORY_LIMIT=30

# Team task board URL substituted into the agent system prompt
# ({{TEAM_TASK_BOARD_URL}}); empty degrades to a neutral placeholder.
TEAM_TASK_BOARD_URL=

# Experimental local-ASR meeting branch. Off means no extra prompt, tools,
# database, worker, socket, or delivery behavior is enabled.
LARK_DAEMON_MEETING_AUDIO_ENABLED=false
# Required only when enabled: exact standalone-send target and one media-only
# worker command. The worker receives the short-lived media WSS URL over stdin.
# LARK_DAEMON_MEETING_AUDIO_TARGET_CHAT_ID=oc_xxx
# LARK_DAEMON_MEETING_AUDIO_WORKER_COMMAND=/path/to/meeting-asr-poc/.venv/bin/python
# LARK_DAEMON_MEETING_AUDIO_WORKER_CWD=/path/to/meeting-asr-poc
# LARK_DAEMON_MEETING_AUDIO_WORKER_ARGS_JSON=["/path/to/lark-daemon/packages/daemon/worker/meeting_asr_worker.py","--poc-dir","/path/to/meeting-asr-poc","--asr","volc"]
# Required 0600 YAML owned by the daemon user. ASR credentials live here; the
# exact provider keys are defined by the external meeting-asr-poc backend.
# LARK_DAEMON_MEETING_AUDIO_ASR_CONFIG_FILE=/path/to/meeting-asr-poc/config.yaml
# LARK_DAEMON_MEETING_AUDIO_CAPABILITY_TTL_MS=120000
# LARK_DAEMON_MEETING_AUDIO_FLY_TTL_MS=600000
