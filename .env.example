# Managed daemon instance. PM2, updater, Web and self-upgrade all derive from
# this id; use lowercase letters, digits and hyphens only.
LARK_DAEMON_INSTANCE_ID=my-agent
LARK_DAEMON_AGENT_NAME="My Agent"

# Pin this daemon and every lark-cli fallback to the same configured profile.
LARK_DAEMON_PROFILE=cli_xxx
LARKSUITE_CLI_PROFILE=cli_xxx

# Managed deployments require absolute, non-overlapping data and workspace paths.
LARK_DAEMON_PORT=3738
LARK_DAEMON_DATA_DIR=/absolute/path/to/.local/share/lark-daemon-my-agent
LARK_DAEMON_WORKSPACE=/absolute/path/to/lark-agent-workspace

# Core message behavior. Set dry-run to true for a non-sending local check.
LARK_DAEMON_ALLOWED_MESSAGE_TYPES=text,post
LARK_DAEMON_DRY_RUN=false

# Optional OpenViking CLI config for this agent. Keep each agent on its own file.
# The file path must be absolute; credentials stay in that config, not in .env.
OPENVIKING_CLI_CONFIG_FILE=/absolute/path/to/.openviking/ovcli.conf.my-agent
