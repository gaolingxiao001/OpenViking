# The active lark-cli profile is auto-detected when this is empty.
LARK_DAEMON_PROFILE=

LARK_CLI_BIN=/opt/homebrew/bin/lark-cli
CODEX_BIN=/opt/homebrew/bin/codex
# Optional. Plain "claude" uses PATH; set the absolute path when the npm global
# bin directory is not on the daemon service's PATH.
CLAUDE_BIN=claude

# Keep the source-tree development default separate from the daemon itself.
# Empty uses ~/Documents/work/lark-agent-workspace; the installed PM2 release
# on this Mac sets ~/Documents/work in ~/.local/lib/lark-daemon/env instead.
LARK_DAEMON_WORKSPACE=

LARK_DAEMON_HOST=127.0.0.1
LARK_DAEMON_PORT=3738
LARK_DAEMON_LOG_LEVEL=info

# text/post only; raw events are enforced by the daemon.
LARK_DAEMON_ALLOWED_MESSAGE_TYPES=text,post

# All chats share one persistent Codex app-server thread (cross-chat context).
# minimal | low | medium | high | xhigh
LARK_DAEMON_CODEX_EFFORT=medium
# Optional model override; empty uses the codex default.
LARK_DAEMON_CODEX_MODEL=

# low | medium | high | xhigh | max
LARK_DAEMON_CLAUDE_EFFORT=medium
# fable | opus | sonnet | haiku; empty uses Claude's configured default.
LARK_DAEMON_CLAUDE_MODEL=

# Maximum observable journal prefix used for a hard runtime handoff.
LARK_DAEMON_COGNITION_MAX_CHARS=120000

# Cross-chat history lines injected into a fresh thread's first turn.
LARK_DAEMON_HISTORY_LIMIT=30
