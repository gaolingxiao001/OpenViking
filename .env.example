# -----------------------------------------------------------------------------
# Managed deployment: required
# -----------------------------------------------------------------------------
# Copy deployment.example.json to a persistent absolute path and define every
# agent there. The manifest owns id/name/profile/port/data/workspace/OV/model.
LARK_DAEMON_DEPLOYMENT_MANIFEST=/absolute/path/to/lark-daemon-deployment.json

# -----------------------------------------------------------------------------
# Agent identity: optional
# -----------------------------------------------------------------------------
# Foreground only: omit to run the manifest defaultInstance, or set one id.
# PM2 injects this automatically for each generated daemon.
# LARK_DAEMON_INSTANCE_ID=my-agent

# Replaces {{TEAM_TASK_BOARD_URL}} in the system prompt. Empty is allowed.
TEAM_TASK_BOARD_URL=

# -----------------------------------------------------------------------------
# Local CLI binaries: optional
# -----------------------------------------------------------------------------
LARK_CLI_BIN=/opt/homebrew/bin/lark-cli
CODEX_BIN=/opt/homebrew/bin/codex
# Plain "claude" uses PATH. Set an absolute path if the service PATH does not
# contain the npm global bin directory.
CLAUDE_BIN=claude

# -----------------------------------------------------------------------------
# Daemon server and message handling: optional for foreground runs
# -----------------------------------------------------------------------------
# Managed PM2 deployments pin HTTP on, loopback host, and raw event mode.
LARK_DAEMON_HOST=127.0.0.1
LARK_DAEMON_HTTP_ENABLED=true
LARK_DAEMON_EVENT_MODE=raw
LARK_DAEMON_LOG_LEVEL=info

# Set true to exercise the runtime without sending messages to Lark.
LARK_DAEMON_DRY_RUN=false

# Comma-separated sender ids. Empty means no sender is suppressed. Message
# types are a daemon-wide code contract, including supported media resources.
LARK_DAEMON_IGNORED_SENDER_IDS=

LARK_DAEMON_SEND_TIMEOUT_MS=30000
LARK_DAEMON_SHUTDOWN_TIMEOUT_MS=20000
LARK_DAEMON_MAX_REPLY_CHARS=30000
LARK_DAEMON_MAX_EVENT_BYTES=1000000
LARK_DAEMON_MAX_EVENT_AGE_MS=86400000

# After this much outbound inactivity, the next long task may show a temporary
# OnIt reaction. Receiving or ignoring a message does not reset the window.
# Set 0 to disable the hint.
LARK_DAEMON_IDLE_REACTION_AFTER_MS=600000

# Retain local business records for 90 days.
LARK_DAEMON_RETENTION_MS=7776000000

# -----------------------------------------------------------------------------
# Models and shared cognition: optional
# -----------------------------------------------------------------------------
# Codex effort: none | minimal | low | medium | high | xhigh
LARK_DAEMON_CODEX_EFFORT=medium
# Per-agent Codex model lives in the deployment manifest.

# Claude effort: low | medium | high | xhigh | max
LARK_DAEMON_CLAUDE_EFFORT=medium
# Claude model: fable | opus | sonnet | haiku; empty uses its configured default.
LARK_DAEMON_CLAUDE_MODEL=

# Codex model used when a Claude turn fails.
FALLBACK_MODEL=gpt-5.6-sol

# Journal size for runtime handoff and history lines injected into a fresh turn.
LARK_DAEMON_COGNITION_MAX_CHARS=120000
LARK_DAEMON_HISTORY_LIMIT=30

# -----------------------------------------------------------------------------
# OpenViking: required per agent
# -----------------------------------------------------------------------------
# Each agent's absolute OpenViking CLI config path lives in the deployment
# manifest. Credentials remain in that per-agent 0600 file.
